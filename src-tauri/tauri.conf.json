{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toasty",
  "version": "0.1.0",
  "identifier": "com.toasty.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Toasty",
        "width": 1024,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["toasty-tidal"]
      }
    }
  }
}
